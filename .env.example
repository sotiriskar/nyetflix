# Optional: for wide backdrop images (hero + carousels).
# Get a free API key at https://www.themoviedb.org/settings/api
# Copy this file to .env.local and add your key.
TMDB_API_KEY=

# Optional: "Sign in with Google / Microsoft / Dropbox" media sources.
# Register an app with each provider first (README → Cloud sign-in setup).
NYETFLIX_MICROSOFT_CLIENT_ID=
NYETFLIX_DROPBOX_APP_KEY=
NYETFLIX_GOOGLE_CLIENT_ID=
NYETFLIX_GOOGLE_CLIENT_SECRET=
